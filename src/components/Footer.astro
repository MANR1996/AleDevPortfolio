---
import { t } from "i18next";
import { NAV_ITEMS } from "../config/site";

const YEAR = new Date().getFullYear();
---

<footer
  class="m-4 mx-auto w-full rounded-lg bg-slate-50 xl:w-[1120px] dark:bg-surface"
>
  <div
    class="mx-auto flex w-full max-w-screen-xl flex-col items-center justify-center gap-4 px-4 py-6 sm:flex-row sm:justify-between"
  >
    <span
      class="w-[150px] rounded-full border-2 border-blue-700 px-2 py-1 text-center text-sm text-blue-700 dark:border-blue-400 dark:text-blue-400"
    >
      © {YEAR} AleDev
    </span>
    <nav aria-label={t("menu.footer")}>
      <ul
        class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm font-medium text-slate-600 md:gap-x-10 md:text-base dark:text-slate-300"
      >
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a
                href={item.href}
                class="whitespace-nowrap transition hover:text-blue-700 dark:hover:text-blue-400"
              >
                {t(item.label)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
