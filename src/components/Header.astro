---
import { t } from "i18next";
import { NAV_ITEMS } from "../config/site";
import LanguageSelector from "./LanguageSelector.astro";
import LogoIcon from "./icons/Logo.astro";
---

<style>
  header {
    padding-inline: 0.5rem;
    column-gap: 0.5rem;
  }
  .smaller {
    animation: smaller-animation linear both;
    animation-timeline: scroll(root block);
    animation-range: 0 200px;
  }
  @keyframes smaller-animation {
    0% {
      height: 96px;
      padding: 1.5rem 0.5rem;
    }
    100% {
      height: 49px;
      padding: 1rem 0.5rem 0.5rem;
      box-shadow: rgba(0, 0, 0, 0.04) 0px 3px 5px;
    }
  }
  @media (max-width: 768px) {
    header nav {
      width: 100%;
    }
    .smaller {
      animation: none;
    }
  }
</style>

<header
  class="smaller fixed left-1/2 z-10 mx-auto flex w-full -translate-x-1/2 flex-wrap content-center items-center justify-between bg-white py-2 md:py-6 xl:w-[1120px] dark:bg-surface"
>
  <a href="#start" aria-label={t("menu.home")}>
    <LogoIcon
      class="size-12 rounded-full border-2 border-black dark:border-white/80"
    />
  </a>
  <nav aria-label={t("menu.navigation")}>
    <ul
      class="flex flex-row flex-wrap items-center justify-center gap-x-4 gap-y-1 text-sm opacity-80 dark:text-white dark:opacity-100 md:flex-nowrap md:gap-x-10 md:gap-y-0 md:text-base"
    >
      {
        NAV_ITEMS.map((item) => (
          <li>
            <a
              href={item.href}
              class="inline-block whitespace-nowrap transition hover:scale-125"
            >
              {t(item.label)}
            </a>
          </li>
        ))
      }
      <li>
        <LanguageSelector />
      </li>
    </ul>
  </nav>
</header>
