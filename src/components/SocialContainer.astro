---
interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;

const isExternalLink = href.startsWith("http");
---

<a
  href={href}
  target={isExternalLink ? "_blank" : undefined}
  rel={isExternalLink ? "noopener noreferrer" : undefined}
  class:list={[
    "flex items-center justify-center gap-x-2 rounded-full border border-slate-900/20 bg-slate-900/5 px-2 py-1 text-slate-900 transition hover:scale-105 hover:border-blue-500/50 hover:bg-slate-900/10 dark:bg-white/80 dark:hover:bg-white",
    className,
  ]}
>
  <slot />
</a>
