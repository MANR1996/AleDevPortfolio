---
import { t } from "i18next";
import GitHubBtn from "./GitHubBtn.astro";
import type { Project } from "../types";

interface Props {
  project: Project;
}

const { title, description, tags, image, github, link } = Astro.props.project;
---

<style>
  article {
    opacity: 0;
    animation: project-fadein linear both;
  }
  .project-timeline {
    animation-timeline: view();
    animation-range: entry 10% cover 20%;
  }
  @keyframes project-fadein {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .image::before {
    position: absolute;
    content: attr(data-label);
    inset: 0;
    z-index: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 0.25rem;
    font-size: 44px;
    color: white;
    background: rgba(0, 0, 0, 0.6);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .image-link:hover .image {
    transform: scale(1.05);
  }
  .image-link:hover .image::before {
    opacity: 1;
  }
  :global(html.dark) .image::before {
    opacity: 1;
  }
  :global(html.dark) .image-link:hover .image::before {
    opacity: 0;
  }
</style>

<article class="project-timeline mb-20">
  <div class="rounded-2xl border border-slate-200 p-4 transition-all duration-300 hover:-translate-y-1 hover:border-blue-500/60 hover:shadow-lg sm:p-6 dark:border-slate-700 dark:hover:border-blue-500/60 dark:hover:shadow-lg dark:hover:shadow-blue-500/10">
    <div class="mb-2 flex flex-col gap-y-2 lg:flex-row lg:place-content-between">
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center transition hover:underline"
      >
        <h3
          class="flex items-center gap-x-2 text-pretty text-2xl font-semibold text-blue-700 dark:text-blue-400"
        >
          {title}
        </h3>
      </a>
      <GitHubBtn href={github} />
    </div>
    <p class="mb-4 text-pretty text-lg text-slate-700 dark:text-slate-300">
      {description}
    </p>
    <ul class="mb-4 flex flex-row flex-wrap gap-x-2 gap-y-2">
      {
        tags.map((tag) => (
          <li>
            <span
              class={`flex items-center gap-x-1 rounded-full border-2 bg-slate-100 px-2 py-1 text-sm text-slate-800 dark:bg-white/90 dark:text-slate-900 ${tag.class}`}
            >
              {tag.icon && <tag.icon class="size-4" />}
              {tag.name}
            </span>
          </li>
        ))
      }
    </ul>
    <a
      href={link}
      target="_blank"
      rel="noopener noreferrer"
      class="image-link block"
    >
      <div
        class="image relative rounded transition-transform duration-[600ms]"
        data-label="»"
      >
        <img
          class="aspect-video h-auto w-full rounded object-cover shadow-2xl shadow-white/30"
          src={image}
          alt={t("project.screenshot", { title })}
          width="960"
          height="540"
          loading="lazy"
          decoding="async"
        />
      </div>
    </a>
  </div>
</article>
