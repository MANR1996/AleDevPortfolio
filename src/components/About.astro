---
import { t } from "i18next";

const PARAGRAPHS = ["first", "second", "third", "fourth"].map((key) =>
  t(`about.${key}`)
);
---

<div class="space-y-6">
  <h3 class="text-lg font-semibold text-gray-900 opacity-80 dark:text-white">
    Manuel Alejandro Naranjo Rey
  </h3>
  {
    PARAGRAPHS.map((paragraph) => (
      <p class="text-pretty text-base font-normal text-gray-500 dark:text-gray-400">
        {paragraph}
      </p>
    ))
  }
</div>
