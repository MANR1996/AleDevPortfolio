---
import { t } from "i18next";
import MailIcon from "./icons/Mail.astro";
import PhoneIcon from "./icons/Phone.astro";

interface Props {
  mail: string;
  phone: string;
}

const { mail, phone } = Astro.props;

const INPUT_CLASS =
  "block w-full rounded-lg border border-slate-300 bg-white p-2.5 text-sm text-slate-900 focus:border-blue-500 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 dark:placeholder-slate-400 dark:focus:border-blue-500 dark:focus:ring-blue-500";

const FORM_ACTION = `https://formsubmit.co/${mail}`;
const AJAX_ENDPOINT = `https://formsubmit.co/ajax/${mail}`;
---

<style>
  @keyframes vibration-animation {
    0%,
    40%,
    50%,
    60%,
    100% {
      transform: rotate(0deg);
    }
    45% {
      transform: rotate(-5deg);
    }
    55% {
      transform: rotate(5deg);
    }
  }

  .vibrate {
    animation: vibration-animation 5s linear infinite;
  }
  .vibrate-hover:hover .vibrate {
    animation: vibration-animation 1s linear infinite;
    scale: 1.2;
  }

  .notification {
    position: fixed;
    bottom: 40px;
    right: 25px;
    z-index: 50;
    display: flex;
    height: 50px;
    width: 250px;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background-color: rgb(37 99 235 / 0.8);
    color: white;
    font-size: 0.875rem;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease-out;
  }
  @media (min-width: 640px) {
    .notification {
      width: 340px;
    }
  }
  .notification[data-open] {
    opacity: 1;
    animation: notification-pop 0.3s ease-out both;
  }
  .notification[data-variant="error"] {
    background-color: rgb(220 38 38 / 0.9);
  }

  @keyframes notification-pop {
    from {
      opacity: 0;
      scale: 0.5;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }

  button[aria-busy="true"]::before {
    content: "";
    width: 1em;
    height: 1em;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 9999px;
    animation: button-spinner 0.6s linear infinite;
  }

  @keyframes button-spinner {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<div
  id="contact-notification"
  role="status"
  class="notification"
  data-success-message={t("contact.popUpMessage")}
  data-error-message={t("contact.popUpMessageError")}
>
</div>

<form
  id="contact-form"
  class="mb-6"
  action={FORM_ACTION}
  method="POST"
  data-endpoint={AJAX_ENDPOINT}
>
  <input type="hidden" name="_subject" value={t("contact.emailSubject")} />
  <input type="hidden" name="_template" value="table" />
  <input
    type="text"
    name="_honey"
    class="hidden"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />
  <div class="mb-6">
    <label for="name" class="mb-2 block text-sm font-medium text-slate-900 dark:text-slate-100">
      {t("contact.name")}
    </label>
    <input
      type="text"
      id="name"
      name="name"
      class={INPUT_CLASS}
      placeholder={t("contact.namePlaceholder")}
      required
    />
  </div>
  <div class="mb-6">
    <label for="email" class="mb-2 block text-sm font-medium text-slate-900 dark:text-slate-100">
      {t("contact.email")}
    </label>
    <input
      type="email"
      id="email"
      name="email"
      class={INPUT_CLASS}
      placeholder={t("contact.emailPlaceholder")}
      required
    />
  </div>
  <div class="mb-6">
    <label for="message" class="mb-2 block text-sm font-medium text-slate-900 dark:text-slate-100">
      {t("contact.message")}
    </label>
    <textarea
      id="message"
      name="message"
      rows="4"
      class={INPUT_CLASS}
      placeholder={t("contact.messagePlaceholder")}
      required
    ></textarea>
  </div>
  <button
    type="submit"
    data-label={t("contact.submit")}
    data-loading-label={t("contact.sending")}
    class="mb-2 flex w-full items-center justify-center gap-x-2 rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 focus:outline-none disabled:cursor-not-allowed disabled:opacity-60 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
  >
    {t("contact.submit")}
  </button>
</form>

<p class="mb-2 w-fit text-sm text-slate-600 vibrate-hover dark:text-slate-300">
  <a href={`mailto:${mail}`} class="flex items-center gap-x-2 hover:underline">
    <MailIcon class="size-5 vibrate" />
    {mail}
  </a>
</p>
<p class="w-fit text-sm text-slate-600 vibrate-hover dark:text-slate-300">
  <a href={`tel:${phone}`} class="flex items-center gap-x-2 hover:underline">
    <PhoneIcon class="size-4 vibrate" />
    {phone}
  </a>
</p>

<script>
  const FORM_SELECTOR = "#contact-form";
  const NOTIFICATION_ID = "contact-notification";
  const NOTIFICATION_DURATION_MS = 5000;

  const form = document.querySelector<HTMLFormElement>(FORM_SELECTOR);
  const submitButton = form?.querySelector<HTMLButtonElement>(
    "button[type='submit']"
  );

  type NotificationVariant = "success" | "error";
  type FormSubmitResponse = { success?: string };

  let hideTimer: ReturnType<typeof setTimeout> | undefined;

  function showNotification(variant: NotificationVariant): void {
    const notification = document.getElementById(NOTIFICATION_ID);
    if (!notification) return;

    const message =
      variant === "error"
        ? notification.dataset.errorMessage
        : notification.dataset.successMessage;
    notification.textContent = message ?? "";
    notification.dataset.variant = variant;
    notification.setAttribute("data-open", "");

    if (hideTimer !== undefined) clearTimeout(hideTimer);
    hideTimer = setTimeout(() => {
      notification.removeAttribute("data-open");
    }, NOTIFICATION_DURATION_MS);
  }

  function setLoading(isLoading: boolean): void {
    if (!submitButton) return;
    submitButton.disabled = isLoading;
    if (isLoading) {
      submitButton.setAttribute("aria-busy", "true");
    } else {
      submitButton.removeAttribute("aria-busy");
    }
    submitButton.textContent = isLoading
      ? submitButton.dataset.loadingLabel ?? ""
      : submitButton.dataset.label ?? "";
  }

  let isSubmitting = false;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !form.dataset.endpoint || isSubmitting) return;

    isSubmitting = true;
    setLoading(true);
    try {
      const response = await fetch(form.dataset.endpoint, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const data = (await response.json().catch(() => null)) as
        | FormSubmitResponse
        | null;
      if (!response.ok || data?.success === "false") {
        throw new Error("Contact form submission was rejected");
      }
      form.reset();
      showNotification("success");
    } catch {
      showNotification("error");
    } finally {
      isSubmitting = false;
      setLoading(false);
    }
  });
</script>
