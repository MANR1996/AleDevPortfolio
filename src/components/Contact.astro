---
import { t } from "i18next";
import MailIcon from "./icons/Mail.astro";
import PhoneIcon from "./icons/Phone.astro";

interface Props {
  mail: string;
  phone: string;
}

const { mail, phone } = Astro.props;
const secureToken = import.meta.env.PUBLIC_SECURE_TOKEN;

const INPUT_CLASS =
  "block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-blue-500 dark:focus:ring-blue-500";
---

<style>
  @keyframes vibration-animation {
    0%,
    40%,
    50%,
    60%,
    100% {
      transform: rotate(0deg);
    }
    45% {
      transform: rotate(-5deg);
    }
    55% {
      transform: rotate(5deg);
    }
  }

  .vibrate {
    animation: vibration-animation 5s linear infinite;
  }
  .vibrate-hover:hover .vibrate {
    animation: vibration-animation 1s linear infinite;
    scale: 1.2;
  }

  .notification {
    display: flex;
    animation: notification-pop 0.3s ease-out both;
  }

  @keyframes notification-pop {
    from {
      opacity: 0;
      scale: 0.5;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }
</style>

<div
  id="contact-notification"
  role="status"
  class="fixed bottom-[40px] right-[25px] hidden h-[50px] w-[250px] items-center justify-center rounded-full bg-blue-600/80 text-white sm:w-[340px]"
>
  {t("contact.popUpMessage")}
</div>

<form id="contact-form" class="mb-6" data-token={secureToken} data-recipient={mail}>
  <div class="mb-6">
    <label for="email" class="mb-2 block text-sm font-medium text-gray-900 dark:text-white">
      {t("contact.email")}
    </label>
    <input
      type="email"
      id="email"
      name="email"
      class={INPUT_CLASS}
      placeholder={t("contact.emailPlaceholder")}
      required
    />
  </div>
  <div class="mb-6">
    <label for="subject" class="mb-2 block text-sm font-medium text-gray-900 dark:text-white">
      {t("contact.subject")}
    </label>
    <input
      type="text"
      id="subject"
      name="subject"
      class={INPUT_CLASS}
      placeholder={t("contact.subjectPlaceholder")}
      required
    />
  </div>
  <div class="mb-6">
    <label for="message" class="mb-2 block text-sm font-medium text-gray-900 dark:text-white">
      {t("contact.message")}
    </label>
    <textarea
      id="message"
      name="message"
      rows="4"
      class={INPUT_CLASS}
      placeholder={t("contact.messagePlaceholder")}
      required
    ></textarea>
  </div>
  <button
    type="submit"
    class="mb-2 block w-full rounded-lg bg-blue-600/80 px-5 py-2.5 text-center text-sm font-medium text-white transition hover:bg-blue-700/80 focus:ring-4 focus:ring-blue-300 focus:outline-none dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
  >
    {t("contact.submit")}
  </button>
</form>

<p class="mb-2 w-fit text-sm text-gray-500 vibrate-hover dark:text-gray-400">
  <a href={`mailto:${mail}`} class="flex items-center gap-x-2 hover:underline">
    <MailIcon class="size-5 vibrate" />
    {mail}
  </a>
</p>
<p class="w-fit text-sm text-gray-500 vibrate-hover dark:text-gray-400">
  <a href={`tel:${phone}`} class="flex items-center gap-x-2 hover:underline">
    <PhoneIcon class="size-4 vibrate" />
    {phone}
  </a>
</p>

<script is:inline src="https://smtpjs.com/v3/smtp.js"></script>
<script>
  declare global {
    interface Window {
      Email?: {
        send: (options: Record<string, string>) => Promise<unknown>;
      };
    }
  }

  const FORM_SELECTOR = "#contact-form";
  const NOTIFICATION_ID = "contact-notification";
  const NOTIFICATION_DURATION_MS = 5000;

  const form = document.querySelector<HTMLFormElement>(FORM_SELECTOR);

  function showNotification(): void {
    const notification = document.getElementById(NOTIFICATION_ID);
    if (!notification) return;
    notification.classList.remove("hidden");
    notification.classList.add("notification");
    setTimeout(() => {
      notification.classList.add("hidden");
      notification.classList.remove("notification");
    }, NOTIFICATION_DURATION_MS);
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const fields = new FormData(form);
    const email = String(fields.get("email") ?? "");
    const subject = String(fields.get("subject") ?? "");
    const message = String(fields.get("message") ?? "");

    window.Email?.send({
      SecureToken: form.dataset.token ?? "",
      To: form.dataset.recipient ?? "",
      From: form.dataset.recipient ?? "",
      Subject: subject,
      Body: `Correo: ${email}\nAsunto: ${subject}\nMensaje: ${message}`,
    }).then(() => {
      form.reset();
      showNotification();
    });
  });
</script>
