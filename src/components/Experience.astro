---
import { t } from "i18next";
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCE = ["first", "second", "third"].map((key) => ({
  date: t(`experience.${key}.date`),
  name: t(`experience.${key}.name`),
  description: t(`experience.${key}.description`),
}));
---

<ol class="relative border-s-2">
  {
    EXPERIENCE.map((item) => (
      <li class="mb-10 ms-4">
        <ExperienceItem {...item} />
      </li>
    ))
  }
</ol>
