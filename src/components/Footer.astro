---
import { t } from "i18next";
import { NAV_ITEMS } from "../config/site";

const YEAR = new Date().getFullYear();
---

<style>
  ul {
    height: 48px;
    display: flex;
    align-items: center;
    overflow: auto;
  }
</style>

<footer
  class="m-4 mx-auto w-full rounded-lg bg-white xl:w-[1120px] dark:bg-surface"
>
  <div
    class="mx-auto flex w-full max-w-screen-xl items-center justify-between gap-x-4 px-4 py-6"
  >
    <span
      class="w-[150px] rounded-full border-2 border-blue-600/80 px-2 py-1 text-center text-sm text-blue-600/80"
    >
      © {YEAR} AleDev
    </span>
    <nav aria-label={t("menu.footer")}>
      <ul
        class="flex items-center gap-x-10 font-medium text-gray-500 dark:text-gray-400"
      >
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a href={item.href}>{t(item.label)}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
