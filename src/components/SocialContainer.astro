---
interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class={`flex items-center justify-center gap-x-2 rounded-full border border-black/20 bg-black/5 px-2 py-1 transition hover:scale-105 hover:bg-black/10 dark:bg-white/80 dark:hover:bg-white ${className ?? ""}`}
>
  <slot />
</a>
