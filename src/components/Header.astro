---
import { t } from "i18next";
import { LanguageSelector } from "astro-i18next/components";
import { NAV_ITEMS } from "../config/site";
import LogoIcon from "./icons/Logo.astro";
---

<style>
  header {
    padding-inline: 0.5rem;
    column-gap: 0.5rem;
  }
  @media (max-width: 600px) {
    header nav {
      width: inherit;
      height: 48px;
      display: flex;
      align-items: center;
      overflow: auto;
    }
  }
  .smaller {
    animation: smaller-animation linear both;
    animation-timeline: scroll(root block);
    animation-range: 0 200px;
  }
  @keyframes smaller-animation {
    0% {
      height: 96px;
      padding: 1.5rem 0.5rem;
    }
    100% {
      height: 49px;
      padding: 1rem 0.5rem 0.5rem;
      box-shadow: rgba(0, 0, 0, 0.04) 0px 3px 5px;
    }
  }
</style>

<header
  class="smaller fixed left-1/2 z-10 mx-auto flex w-full -translate-x-1/2 items-center justify-between bg-white py-6 xl:w-[1120px] dark:bg-surface"
>
  <a href="#start" aria-label={t("menu.home")}>
    <LogoIcon
      class="size-12 rounded-full border-2 border-black dark:border-white/80"
    />
  </a>
  <nav aria-label={t("menu.navigation")}>
    <ul
      class="flex flex-row gap-x-10 opacity-80 dark:text-white dark:opacity-100"
    >
      {
        NAV_ITEMS.map((item) => (
          <li class="transition hover:scale-125">
            <a href={item.href}>{t(item.label)}</a>
          </li>
        ))
      }
      <li>
        <LanguageSelector
          showFlag
          class="dark:bg-surface dark:text-white/80"
        />
      </li>
    </ul>
  </nav>
</header>
