---
import Layout from "../layouts/Layout.astro";
---

<Layout
  lang="es"
  title="404 | AleDev's Portfolio"
  description="Página no encontrada / Page not found"
  noindex
>
  <main id="main" class="grow px-4">
    <section
      class="mx-auto flex min-h-[60vh] w-full max-w-[810px] flex-col items-center justify-center gap-6 text-center"
    >
      <p class="text-2xl/[40px] font-bold text-black dark:text-white/80 sm:text-4xl/[70px]">
        404
      </p>
      <h1 class="text-xl text-gray-500 dark:text-gray-400">
        Página no encontrada / Page not found
      </h1>
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
        <a
          href="/"
          class="rounded-full border border-black/20 bg-black/5 px-4 py-2 text-sm transition hover:scale-105 hover:bg-black/10 dark:bg-white/80 dark:hover:bg-white"
        >
          Inicio
        </a>
        <a
          href="/en"
          class="rounded-full border border-black/20 bg-black/5 px-4 py-2 text-sm transition hover:scale-105 hover:bg-black/10 dark:bg-white/80 dark:hover:bg-white"
        >
          Home
        </a>
      </div>
    </section>
  </main>
</Layout>
