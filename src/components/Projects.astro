---
import { t } from "i18next";
import i18next from "i18next";
// @ts-ignore -- astro-i18next beta ships types that TypeScript cannot resolve through its "exports" map
import { localizePath } from "astro-i18next";
import AstroIcon from "./icons/AstroIcon.astro";
import CSSIcon from "./icons/CSS.astro";
import HTMLIcon from "./icons/HTML.astro";
import JavaScriptIcon from "./icons/JavaScript.astro";
import JestIcon from "./icons/Jest.astro";
import MaterialUIIcon from "./icons/MaterialUI.astro";
import ProjectItem from "./ProjectItem.astro";
import RapidApiIcon from "./icons/RapidApi.astro";
import ReactIcon from "./icons/React.astro";
import ReduxIcon from "./icons/Redux.astro";
import RemixIcon from "./icons/Remix.astro";
import StoryBookIcon from "./icons/StoryBook.astro";
import StyledComponentsIcon from "./icons/StyledComponents.astro";
import TailwindIcon from "./icons/Tailwind.astro";
import TypeScriptIcon from "./icons/TypeScript.astro";
import ViteIcon from "./icons/Vite.astro";
import type { Tag, Project } from "../types";

const TAGS = {
  HTML: { name: "HTML 5", class: "border-[#D5502B]", icon: HTMLIcon },
  CSS: { name: "CSS", class: "border-[#1571AF]", icon: CSSIcon },
  MaterialUI: { name: "Material-UI", class: "border-[#0A7CEF]", icon: MaterialUIIcon },
  React: { name: "ReactJS", class: "border-[#0ACCEF]", icon: ReactIcon },
  Remix: { name: "Remix", class: "border-[#1A1A1A]", icon: RemixIcon },
  Tailwind: { name: "Tailwind CSS", class: "border-[#23A3B1]", icon: TailwindIcon },
  TypeScript: { name: "TypeScript", class: "border-[#3575BB]", icon: TypeScriptIcon },
  RapidApi: { name: "Rapid API", class: "border-[#23456E]", icon: RapidApiIcon },
  JavaScript: { name: "JavaScript", class: "border-[#E2CF51]", icon: JavaScriptIcon },
  Elastic: { name: "Elastic Email", class: "border-[#2D2F7A]" },
  Astro: { name: "Astro", class: "border-[#EE5D0A]", icon: AstroIcon },
  Jest: { name: "Jest", class: "border-[#99425B]", icon: JestIcon },
  Redux: { name: "Redux", class: "border-[#764ABC]", icon: ReduxIcon },
  StoryBook: { name: "StoryBook", class: "border-[#EF4A81]", icon: StoryBookIcon },
  StyledComponents: { name: "StyledComponents", class: "border-[#FDD641]", icon: StyledComponentsIcon },
  Vite: { name: "Vite", class: "border-[#FFCF27]", icon: ViteIcon },
} satisfies Record<string, Tag>;

const locale = i18next.language ?? "es";

const PROJECTS: Project[] = [
  {
    title: t("project.first.title"),
    description: t("project.first.description"),
    tags: [TAGS.React, TAGS.TypeScript, TAGS.MaterialUI, TAGS.HTML, TAGS.CSS],
    image: "/ShopProject.webp",
    github: "https://github.com/MANR1996/ShopApp",
    link: "https://react-challange-pearl.vercel.app/",
  },
  {
    title: t("project.second.title"),
    description: t("project.second.description"),
    tags: [TAGS.Remix, TAGS.React, TAGS.Tailwind, TAGS.TypeScript, TAGS.RapidApi, TAGS.HTML, TAGS.CSS],
    image: "/MovieProject.webp",
    github: "https://github.com/MANR1996/MovieApp",
    link: "https://movie-app-two-gray.vercel.app/topmovies",
  },
  {
    title: t("project.third.title"),
    description: t("project.third.description"),
    tags: [TAGS.Astro, TAGS.Tailwind, TAGS.Elastic, TAGS.TypeScript, TAGS.HTML, TAGS.CSS],
    image: "/PortfolioProject.webp",
    github: "https://github.com/MANR1996/AleDevPortfolio",
    link: localizePath("/", locale),
  },
  {
    title: t("project.fourth.title"),
    description: t("project.fourth.description"),
    tags: [TAGS.Vite, TAGS.React, TAGS.Redux, TAGS.Jest, TAGS.StoryBook, TAGS.JavaScript, TAGS.StyledComponents, TAGS.HTML, TAGS.CSS],
    image: "/TestProject.webp",
    github: "https://github.com/MANR1996/TestApp",
    link: "https://tests-app.vercel.app/",
  },
];
---

{
  PROJECTS.map((project) => (
    <ProjectItem project={project} />
  ))
}
