---
import { changeLanguage, t } from "i18next";
import Layout from "../layouts/Layout.astro";
import About from "./About.astro";
import Badge from "./Badge.astro";
import Contact from "./Contact.astro";
import Experience from "./Experience.astro";
import Projects from "./Projects.astro";
import SectionContainer from "./SectionContainer.astro";
import SectionHeading from "./SectionHeading.astro";
import SocialContainer from "./SocialContainer.astro";
import BriefCaseIcon from "./icons/BriefCase.astro";
import CodeIcon from "./icons/Code.astro";
import ContactIcon from "./icons/Contact.astro";
import GitHubIcon from "./icons/GitHub.astro";
import LinkedInIcon from "./icons/LinkedIn.astro";
import MailIcon from "./icons/Mail.astro";
import ResearchGateIcon from "./icons/ResearchGate.astro";
import UserIcon from "./icons/User.astro";
import { CURRENT_STATUS, SITE, STATUS_STYLES } from "../config/site";
import type { Locale } from "../config/site";
import { getYearsSince } from "../utils/date";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

changeLanguage(locale);

const yearsOfExperience = getYearsSince(SITE.careerStart);

const status = {
  key: CURRENT_STATUS,
  label: t(`site.status.${CURRENT_STATUS}`),
  class: STATUS_STYLES[CURRENT_STATUS],
};

const titleOptions = (
  ["first", "second", "third", "fourth", "fifth"] as const
).map((option) => t(`site.presentation.options.${option}`));

const socialProfiles = [
  { href: SITE.profiles.linkedin, name: "LinkedIn", icon: LinkedInIcon },
  { href: SITE.profiles.github, name: "GitHub", icon: GitHubIcon },
  { href: SITE.profiles.researchgate, name: "ResearchGate", icon: ResearchGateIcon },
  { href: `mailto:${SITE.mail}`, name: SITE.mail, icon: MailIcon },
];

const experienceSummary = [
  yearsOfExperience,
  t("site.years"),
  t("site.experience.first"),
  t("site.experience.second"),
].join("");

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  jobTitle: t("site.jobTitle"),
  email: `mailto:${SITE.mail}`,
  sameAs: [
    SITE.profiles.linkedin,
    SITE.profiles.github,
    SITE.profiles.researchgate,
  ],
};
---

<style>
  .rotating-options {
    animation: text-anim 24s cubic-bezier(0.18, 0.89, 0.32, 1.27) infinite both;
  }
  @keyframes text-anim {
    0%,
    40% {
      transform: translateY(0);
    }
    42%,
    54.5% {
      transform: translateY(calc(-1 * var(--line)));
    }
    56.5%,
    69% {
      transform: translateY(calc(-2 * var(--line)));
    }
    71%,
    83.5% {
      transform: translateY(calc(-3 * var(--line)));
    }
    85.5%,
    98% {
      transform: translateY(calc(-4 * var(--line)));
    }
    100% {
      transform: translateY(0);
    }
  }

  @media (min-width: 640px) {
    .typing {
      width: calc(var(--chars) * 1ch + 4px);
      overflow: hidden;
      white-space: nowrap;
      border-right: 2px solid transparent;
      animation:
        typing 4s steps(var(--chars)),
        blink 0.5s 10 step-end alternate forwards;
    }
    @keyframes typing {
      from {
        width: 0;
      }
    }
    @keyframes blink {
      50% {
        border-color: currentColor;
      }
    }
  }
</style>

<Layout
  lang={locale}
  title={t("site.title")}
  description={t("site.description", { years: yearsOfExperience })}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(personSchema)}
  />
  <main id="main" class="grow px-4">
    <SectionContainer id="start" class="pb-12 pt-28 lg:pb-24 lg:pt-44">
      <div class="flex items-center">
        {
          status.key === "working" ? (
            <Badge text={status.label} class={status.class} />
          ) : (
            <a class="flex" href="#contact">
              <Badge text={status.label} class={status.class} />
            </a>
          )
        }
      </div>
      <h1
        class="block gap-x-4 whitespace-nowrap pb-4 text-2xl/[40px] font-bold text-black dark:text-white/80 [--line:40px] sm:flex sm:text-4xl/[50px] sm:[--line:50px] md:leading-[70px] md:[--line:70px] lg:text-5xl/[70px]"
      >
        {t("site.presentation.title")}
        <span class="block h-[var(--line)] overflow-hidden">
          <span class="rotating-options block leading-[var(--line)]">
            {
              titleOptions.map((option) => (
                <span class="block whitespace-nowrap">{option}</span>
              ))
            }
          </span>
        </span>
      </h1>
      <h2
        class="typing mb-2 text-xl opacity-50 dark:text-white dark:opacity-80 lg:text-2xl"
        style={`--chars: ${experienceSummary.length}`}
      >
        <span class="text-blue-600/80 dark:text-blue-400">
          {yearsOfExperience}{t("site.years")}
        </span>
        {t("site.experience.first")}
        <span class="text-blue-600/80 dark:text-blue-400">
          {t("site.experience.second")}
        </span>
      </h2>
      <nav class="flex flex-wrap gap-x-4 gap-y-2" aria-label={t("menu.social")}>
        {
          socialProfiles.map((profile) => (
            <SocialContainer href={profile.href}>
              <profile.icon class="size-5 rounded-md" /> {profile.name}
            </SocialContainer>
          ))
        }
      </nav>
    </SectionContainer>

    <SectionContainer id="about" class="mb-24">
      <SectionHeading title={t("site.sections.about")}>
        <UserIcon slot="icon" class="size-6" />
      </SectionHeading>
      <About />
    </SectionContainer>

    <SectionContainer id="experience" class="mb-24">
      <SectionHeading title={t("site.sections.experience")}>
        <BriefCaseIcon slot="icon" class="size-6" />
      </SectionHeading>
      <Experience />
    </SectionContainer>

    <SectionContainer id="projects" class="mb-24">
      <SectionHeading title={t("site.sections.projects")}>
        <CodeIcon slot="icon" class="size-6" />
      </SectionHeading>
      <Projects />
    </SectionContainer>

    <SectionContainer id="contact" class="mb-24">
      <SectionHeading title={t("site.sections.contact")}>
        <ContactIcon slot="icon" class="size-6" />
      </SectionHeading>
      <Contact mail={SITE.mail} phone={SITE.phone} />
    </SectionContainer>
  </main>
</Layout>
