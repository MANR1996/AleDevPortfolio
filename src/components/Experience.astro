---
import { t } from "i18next";
import ExperienceItem from "./ExperienceItem.astro";
import type { Experience } from "../types";

const EXPERIENCE: Experience[] = [
  {
    dateFrom: t("experience.first.from"),
    dateTo: t("experience.first.to"),
    fromIso: "2019-01",
    toIso: "2023-09",
    name: t("experience.first.name"),
    description: t("experience.first.description"),
  },
  {
    dateFrom: t("experience.second.from"),
    dateTo: t("experience.second.to"),
    fromIso: "2019-09",
    toIso: "2019-10",
    name: t("experience.second.name"),
    description: t("experience.second.description"),
  },
  {
    dateFrom: t("experience.third.from"),
    dateTo: t("experience.third.to"),
    fromIso: "2020-09",
    toIso: null,
    name: t("experience.third.name"),
    description: t("experience.third.description"),
  },
  {
    dateFrom: t("experience.fourth.from"),
    dateTo: t("experience.fourth.to"),
    fromIso: "2020-09",
    toIso: null,
    name: t("experience.fourth.name"),
    description: t("experience.fourth.description"),
  },
  {
    dateFrom: t("experience.fifth.from"),
    dateTo: t("experience.fifth.to"),
    fromIso: "2020-09",
    toIso: null,
    name: t("experience.fifth.name"),
    description: t("experience.fifth.description"),
  },
];
---

<ol class="relative border-s-2">
  {
    EXPERIENCE.map((experience) => (
      <li class="mb-10 ms-4">
        <ExperienceItem experience={experience} />
      </li>
    ))
  }
</ol>
