---
import type { Experience } from "../types";

interface Props {
  experience: Experience;
}

const { dateFrom, dateTo, fromIso, toIso, name, description } =
  Astro.props.experience;
---

<style>
  .fadein-animation {
    animation: experience-fadein linear both;
  }
  .fadein-timeline {
    animation-timeline: view();
    animation-range: entry 10% cover 20%;
  }
  @keyframes experience-fadein {
    from {
      opacity: 0;
      transform: translateX(20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>

<div
  class="absolute -start-2 mt-1.5 size-3.5 rounded-full border-2 border-blue-600 bg-white dark:border-blue-500 dark:bg-slate-900"
>
</div>
<p
  class="fadein-animation fadein-timeline mb-1 text-sm font-normal leading-none text-slate-600 dark:text-slate-300"
>
  <time datetime={fromIso}>{dateFrom}</time>
  <span aria-hidden="true"> - </span>
  {toIso ? <time datetime={toIso}>{dateTo}</time> : <span>{dateTo}</span>}
</p>
<h3
  class="fadein-animation fadein-timeline text-lg font-semibold text-slate-900 dark:text-slate-100"
>
  {name}
</h3>
<p
  class="fadein-animation fadein-timeline text-pretty text-base font-normal text-slate-700 dark:text-slate-300"
>
  {description}
</p>
