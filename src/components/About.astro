---
import { t } from "i18next";
import { SITE } from "../config/site";
import { getYearsSince } from "../utils/date";

const yearsOfExperience = getYearsSince(SITE.careerStart);

const PARAGRAPHS = ["first", "second", "third", "fourth"].map((key) =>
  t(`about.${key}`, { years: yearsOfExperience })
);
---

<div class="space-y-6">
  <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">
    {SITE.name}
  </h3>
  {
    PARAGRAPHS.map((paragraph) => (
      <p class="text-pretty text-base font-normal text-slate-700 dark:text-slate-300">
        {paragraph}
      </p>
    ))
  }
</div>
