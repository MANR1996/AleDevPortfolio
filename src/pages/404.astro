---
import Layout from "../layouts/Layout.astro";
---

<Layout
  lang="es"
  title="404 | AleDev's Portfolio"
  description="Página no encontrada / Page not found"
  noindex
>
  <main id="main" class="grow px-4">
    <section
      class="mx-auto flex min-h-[60vh] w-full max-w-[810px] flex-col items-center justify-center gap-6 text-center"
    >
      <p
        class="text-2xl/[40px] font-bold text-slate-900 dark:text-slate-50 sm:text-4xl/[70px]"
      >
        404
      </p>
      <h1 class="text-xl text-slate-600 dark:text-slate-300">
        Página no encontrada / Page not found
      </h1>
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
        <a
          href="/"
          class="rounded-full border border-slate-900/20 bg-slate-900/5 px-4 py-2 text-sm text-slate-900 transition hover:scale-105 hover:border-blue-500/50 hover:bg-slate-900/10 dark:bg-white/80 dark:hover:bg-white"
        >
          Inicio
        </a>
        <a
          href="/en"
          class="rounded-full border border-slate-900/20 bg-slate-900/5 px-4 py-2 text-sm text-slate-900 transition hover:scale-105 hover:border-blue-500/50 hover:bg-slate-900/10 dark:bg-white/80 dark:hover:bg-white"
        >
          Home
        </a>
      </div>
    </section>
  </main>
</Layout>
