---
import { t } from "i18next";
import MailIcon from "./icons/Mail.astro";
import PhoneIcon from "./icons/Phone.astro";

interface Props {
  mail: string;
  phone: string;
}

const { mail, phone } = Astro.props;

const INPUT_CLASS =
  "block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-blue-500 dark:focus:ring-blue-500";

const FORM_ACTION = `https://formsubmit.co/${mail}`;
const AJAX_ENDPOINT = `https://formsubmit.co/ajax/${mail}`;
---

<style>
  @keyframes vibration-animation {
    0%,
    40%,
    50%,
    60%,
    100% {
      transform: rotate(0deg);
    }
    45% {
      transform: rotate(-5deg);
    }
    55% {
      transform: rotate(5deg);
    }
  }

  .vibrate {
    animation: vibration-animation 5s linear infinite;
  }
  .vibrate-hover:hover .vibrate {
    animation: vibration-animation 1s linear infinite;
    scale: 1.2;
  }

  .notification {
    display: flex;
    animation: notification-pop 0.3s ease-out both;
  }

  @keyframes notification-pop {
    from {
      opacity: 0;
      scale: 0.5;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }

  button[aria-busy="true"]::before {
    content: "";
    width: 1em;
    height: 1em;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 9999px;
    animation: button-spinner 0.6s linear infinite;
  }

  @keyframes button-spinner {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<div
  id="contact-notification"
  role="status"
  class="fixed bottom-[40px] right-[25px] hidden h-[50px] w-[250px] items-center justify-center rounded-full bg-blue-600/80 text-white sm:w-[340px]"
>
  {t("contact.popUpMessage")}
</div>

<form
  id="contact-form"
  class="mb-6"
  action={FORM_ACTION}
  method="POST"
  data-endpoint={AJAX_ENDPOINT}
>
  <input type="hidden" name="_subject" value={t("contact.emailSubject")} />
  <div class="mb-6">
    <label for="name" class="mb-2 block text-sm font-medium text-gray-900 dark:text-white">
      {t("contact.name")}
    </label>
    <input
      type="text"
      id="name"
      name="name"
      class={INPUT_CLASS}
      placeholder={t("contact.namePlaceholder")}
      required
    />
  </div>
  <div class="mb-6">
    <label for="email" class="mb-2 block text-sm font-medium text-gray-900 dark:text-white">
      {t("contact.email")}
    </label>
    <input
      type="email"
      id="email"
      name="email"
      class={INPUT_CLASS}
      placeholder={t("contact.emailPlaceholder")}
      required
    />
  </div>
  <div class="mb-6">
    <label for="message" class="mb-2 block text-sm font-medium text-gray-900 dark:text-white">
      {t("contact.message")}
    </label>
    <textarea
      id="message"
      name="message"
      rows="4"
      class={INPUT_CLASS}
      placeholder={t("contact.messagePlaceholder")}
      required
    ></textarea>
  </div>
  <button
    type="submit"
    data-label={t("contact.submit")}
    data-loading-label={t("contact.sending")}
    class="mb-2 flex w-full items-center justify-center gap-x-2 rounded-lg bg-blue-600/80 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-blue-700/80 focus:ring-4 focus:ring-blue-300 focus:outline-none disabled:cursor-not-allowed disabled:opacity-60 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
  >
    {t("contact.submit")}
  </button>
</form>

<p class="mb-2 w-fit text-sm text-gray-500 vibrate-hover dark:text-gray-400">
  <a href={`mailto:${mail}`} class="flex items-center gap-x-2 hover:underline">
    <MailIcon class="size-5 vibrate" />
    {mail}
  </a>
</p>
<p class="w-fit text-sm text-gray-500 vibrate-hover dark:text-gray-400">
  <a href={`tel:${phone}`} class="flex items-center gap-x-2 hover:underline">
    <PhoneIcon class="size-4 vibrate" />
    {phone}
  </a>
</p>

<script>
  const FORM_SELECTOR = "#contact-form";
  const NOTIFICATION_ID = "contact-notification";
  const NOTIFICATION_DURATION_MS = 5000;

  const form = document.querySelector<HTMLFormElement>(FORM_SELECTOR);
  const submitButton = form?.querySelector<HTMLButtonElement>(
    "button[type='submit']"
  );

  function showNotification(): void {
    const notification = document.getElementById(NOTIFICATION_ID);
    if (!notification) return;
    notification.classList.remove("hidden");
    notification.classList.add("notification");
    setTimeout(() => {
      notification.classList.add("hidden");
      notification.classList.remove("notification");
    }, NOTIFICATION_DURATION_MS);
  }

  function setLoading(isLoading: boolean): void {
    if (!submitButton) return;
    submitButton.disabled = isLoading;
    if (isLoading) {
      submitButton.setAttribute("aria-busy", "true");
    } else {
      submitButton.removeAttribute("aria-busy");
    }
    submitButton.textContent = isLoading
      ? submitButton.dataset.loadingLabel ?? ""
      : submitButton.dataset.label ?? "";
  }

  let isSubmitting = false;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (isSubmitting) return;
    isSubmitting = true;
    setLoading(true);
    try {
      const response = await fetch(form.dataset.endpoint ?? "", {
        method: "POST",
        body: new FormData(form),
      });
      if (response.ok) {
        form.reset();
        showNotification();
      }
    } catch {
      return;
    } finally {
      isSubmitting = false;
      setLoading(false);
    }
  });
</script>
