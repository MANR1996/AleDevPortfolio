---
import type { Experience } from "../types";

interface Props {
  experience: Experience;
}

const { dateFrom, dateTo, fromIso, toIso, name, description } =
  Astro.props.experience;
---

<style>
  .fadein-animation {
    animation: experience-fadein linear both;
    animation-timeline: view();
    animation-range: entry 10% cover 20%;
  }
  @keyframes experience-fadein {
    from {
      opacity: 0;
      transform: translateX(20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>

<div
  class="absolute -start-1.5 mt-1.5 size-3 rounded-full border border-white bg-blue-600/80 opacity-50 dark:border-white dark:bg-white dark:opacity-100"
>
</div>
<p
  class="fadein-animation mb-1 text-sm font-normal leading-none text-gray-400 dark:text-white/80"
>
  <time datetime={fromIso}>{dateFrom}</time>
  <span aria-hidden="true"> - </span>
  {toIso ? <time datetime={toIso}>{dateTo}</time> : <span>{dateTo}</span>}
</p>
<h3
  class="fadein-animation text-lg font-semibold text-gray-900 opacity-80 dark:text-white"
>
  {name}
</h3>
<p
  class="fadein-animation text-pretty text-base font-normal text-gray-500 dark:text-gray-400"
>
  {description}
</p>
